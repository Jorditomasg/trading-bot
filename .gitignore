# `.claude/` is local scratch EXCEPT project skills, which are part of the repo's
# tooling and must survive a fresh clone (see docs/trading_skills.md). Needs the
# `/*` form: git cannot un-ignore a path inside an excluded directory.
.claude/*
!.claude/skills/

# Type checkers / linters
.mypy_cache/
.ruff_cache/

# Streamlit cache
.streamlit/cache/

# Editor backups
*.bak
*.orig

# Local research artifacts (QuantStats reports, Optuna studies, ad-hoc analyses)
# These are NOT runtime deps — generated by host venv tooling, not used by the
# Docker image. Anything written here stays local.
reports/
tearsheets/
optuna_studies/
research/
*.tearsheet.html
requirements-research.txt
